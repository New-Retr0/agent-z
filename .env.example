# --- Discord (Chat SDK / apps/web) ---
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
# Optional: DISCORD_ALLOWED_GUILD_IDS=111111111111111111,222222222222222222
# Optional: DISCORD_MENTION_ROLE_IDS=id1,id2 — extra role mentions that invoke the bot
#
# Mention/reply messages need Discord Gateway forwarding. Competition path:
# run `npm run gateway` as a tiny always-on relay and keep agent logic in apps/web.
# Enable Bot → Message Content Intent in the Discord developer portal.
#
# Optional fallback only: set both values to use GET /api/discord/gateway instead of the relay.
ENABLE_VERCEL_GATEWAY_LISTENER=
CRON_SECRET=

# --- Neon PostgreSQL (Prisma + Chat SDK state-pg) ---
DATABASE_URL=
# Optional: DIRECT_URL= for `prisma migrate` if needed (non-pooled)

# --- Vercel AI Gateway / OIDC ---
AI_GATEWAY_API_KEY=

# --- apps/web /admin (shared password) ---
# Long random string; used to set httpOnly session cookie
AGENT_Z_ADMIN_SECRET=

# --- Bot → Vercel workflow (POST /api/workflow/invoke) ---
# Set the same value in Vercel and locally when testing webhooks
AGENT_Z_INTERNAL_SECRET=
# Public base URL of apps/web (Discord handlers and gateway relay call into this)
AGENT_Z_APP_BASE_URL=http://localhost:3000

# Optional: Clerk (if you add Clerk later)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SECRET=

# --- Legacy bot/ (deprecated) — see bot/.env.example ---
# REACTION_VERIFIED_ROLE_ID=
# AI_GATEWAY_API_KEY is shared

# Build-time only: skip t3 env validation
# SKIP_ENV_VALIDATION=1
