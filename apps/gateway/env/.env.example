# apps/gateway — discord.js relay (optional)
# Copy to ../.env next to this folder (apps/gateway/.env). This is the only file the gateway loads from disk.
# Template: apps/gateway/env/.env.example

DISCORD_BOT_TOKEN=
# Trimmed origin of apps/web (no trailing slash). Must match the live deployment for mentions/replies.
# Local: http://localhost:3000 — production example: https://agent-z-discord-mcp.vercel.app
AGENT_Z_APP_BASE_URL=http://localhost:3000

# Optional: comma-separated role snowflakes. Messages that @mention these roles (without @bot user) still set is_mention.
# DISCORD_MENTION_ROLE_IDS=111111111111111111,222222222222222222

# Optional
# AGENT_Z_GATEWAY_ACTIVITY=Agent Z
# Message Content is a privileged intent. If AGENT_Z_MESSAGE_CONTENT_INTENT=1, enable
# "Message Content Intent" under Discord Developer Portal → Your app → Bot → Privileged Gateway Intents.
# Mismatch causes: Error: Used disallowed intents (WS close). If you do not need message body text
# for mention detection, omit this or set 0.
AGENT_Z_MESSAGE_CONTENT_INTENT=1
# AGENT_Z_OVERSIGHT_ENABLED=1
# AGENT_Z_OVERSIGHT_INCLUDE_BOTS=0

# On Railway, RAILWAY_ENVIRONMENT / RAILWAY_PROJECT_ID are set; bundled .env does not override secrets.
