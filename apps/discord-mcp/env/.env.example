# apps/discord-mcp — Streamable HTTP MCP at POST /api/mcp
# Copy to ../.env for local `next dev`, or set in the MCP Vercel project.
# Template: apps/discord-mcp/env/.env.example

# Required: bearer for MCP clients (Authorization: Bearer …)
MCP_API_KEY=

# Required: @repo/discord-tools HTTP API calls
DISCORD_BOT_TOKEN=

# Required: Prisma (role tier mappings, etc.)
DATABASE_URL=

# Required for staged admin tools + oversight search + recall_recent_context: same values as apps/web
# Must be the apps/web origin (not this MCP host), e.g. https://agent-z-discord-mcp.vercel.app in production
AGENT_Z_APP_BASE_URL=http://localhost:3000
AGENT_Z_INTERNAL_SECRET=

# Optional: Redis for mcp-handler (e.g. resumable SSE)
# REDIS_URL=

# Optional: guild allowlist for Discord API paths
# DISCORD_ALLOWED_GUILD_IDS=
# DISCORD_API_VERSION=10

# Optional: tier override
# AGENT_Z_OWNER_DISCORD_ID=

# Optional: MCP role / verified-role guards (same semantics as discord-tools)
# REACTION_VERIFIED_ROLE_ID=
# MCP_ALLOW_DELETE_VERIFIED_ROLE=0
# PROTECTED_OWNER_USER_ID=

# If Discord’s Interactions URL hits this host, AGENT_Z_APP_BASE_URL must be the **web** origin so /api/discord can proxy (see app/api/discord/route.ts).

# Build-time only
# SKIP_ENV_VALIDATION=1
