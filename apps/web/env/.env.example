# apps/web — copy to ../.env (Next.js reads apps/web/.env)
# Template: apps/web/env/.env.example
# Gateway toggles: see apps/gateway/env/.env.example

# --- Discord (Chat SDK → packages/chat-bot) ---
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
# Optional: comma-separated guild snowflakes; when set, Discord API paths are checked (MCP / discord-tools).
# DISCORD_ALLOWED_GUILD_IDS=111111111111111111,222222222222222222
#
# Mention/reply and reaction-verify need Gateway forwarding: `npm run gateway` from repo root.
# Point AGENT_Z_APP_BASE_URL at this web origin. For full reply text, enable Message Content Intent
# on the gateway (AGENT_Z_MESSAGE_CONTENT_INTENT=1).
#
# Oversight: gateway POSTs /api/discord/oversight with x-discord-gateway-token = DISCORD_BOT_TOKEN.

CRON_SECRET=

# --- Neon PostgreSQL (Prisma + Chat SDK state-pg) ---
DATABASE_URL=
# Optional: DIRECT_URL= for `prisma migrate` if needed (non-pooled)

# --- Vercel AI Gateway ---
AI_GATEWAY_API_KEY=

# --- /admin (shared password, httpOnly cookie) ---
AGENT_Z_ADMIN_SECRET=

# --- Shared internal secret (chat-bot, cron, MCP→web) ---
# POST /api/agent/direct, /api/discord/verify, some /api/cron/*, /api/internal/pending-actions
AGENT_Z_INTERNAL_SECRET=
AGENT_Z_APP_BASE_URL=http://localhost:3000
# Optional: landing-page links
# NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite
# NEXT_PUBLIC_REPO_URL=https://github.com/your-org/your-repo

# --- In-process MCP client (runAgentZ Discord tools) ---
# DISCORD_MCP_URL=https://your-mcp-host.example/api/mcp
# DISCORD_MCP_API_KEY=high-entropy-secret
# Must match MCP_API_KEY on apps/discord-mcp when using one shared secret.

# --- Optional: Upstash Redis REST (rate limits + embed queue in packages/db) ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: Discord user id → always admin after channel allowlist (discord-access.ts)
# AGENT_Z_OWNER_DISCORD_ID=

# Optional: Clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SECRET=

# Optional: embeddings model (Oversight)
# AGENT_Z_EMBED_MODEL=

# Optional: Context7 MCP in the agent
# AGENT_Z_CONTEXT7_ENABLED=1
# CONTEXT7_MCP_URL=
# CONTEXT7_API_KEY=

# Optional: admin “MCP server” page introspection uses the same vars as the agent when set:
# DISCORD_MCP_URL + DISCORD_MCP_API_KEY. You can instead set only:
# MCP_ENDPOINT_URL=
# MCP_BASE_URL=
# AGENT_Z_MCP_TOKEN=

# Optional: discord-tools role guards (verify channel/message/emoji are in Postgres runtime-config)
# DISCORD_API_VERSION=10
# REACTION_VERIFIED_ROLE_ID=
# MCP_ALLOW_DELETE_VERIFIED_ROLE=0
# PROTECTED_OWNER_USER_ID=

# Optional: alpha diagnostics — prepend discord_* tool count to `/agent-z-admin` replies
# AGENT_Z_DIAGNOSTICS_HEADER=1

