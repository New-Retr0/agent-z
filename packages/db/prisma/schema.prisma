// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BotConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  valueJson String   @map("value_json")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model RoleMapping {
  id             String   @id @default(cuid())
  kind           String
  discordRoleId  String   @map("discord_role_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([kind])
  @@map("role_mapping")
}

model ChannelMapping {
  id              String   @id @default(cuid())
  kind            String
  discordChannelId String @map("discord_channel_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([kind])
  @@map("channel_mapping")
}

model RateLimit {
  id     String  @id @default(cuid())
  kind   String
  value  Int
  bypassUserIds String[] @default([]) @map("bypass_user_ids")

  @@unique([kind])
  @@map("rate_limit")
}

model AgentRun {
  id              String   @id @default(cuid())
  tier            String
  invokerUserId   String   @map("invoker_user_id")
  prompt          String
  modelId         String   @map("model_id")
  status          String
  stepCount       Int      @default(0) @map("step_count")
  tokensIn        Int      @default(0) @map("tokens_in")
  tokensOut       Int      @default(0) @map("tokens_out")
  costUsd         Decimal? @map("cost_usd") @db.Decimal(20, 10)
  startedAt       DateTime @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  workflowRunId   String?  @map("workflow_run_id")
  lastWebhookAt   DateTime? @map("last_webhook_at")

  steps           AgentRunStep[]

  @@index([startedAt])
  @@index([status])
  @@map("agent_run")
}

model AgentRunStep {
  id        String   @id @default(cuid())
  runId     String   @map("run_id")
  stepIndex Int      @map("step_index")
  toolCalls Json?    @map("tool_calls")
  text      String?  @db.Text
  usage     Json?
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, stepIndex])
  @@map("agent_run_step")
}

model Confirmation {
  id             String   @id @default(cuid())
  workflowRunId  String?  @map("workflow_run_id")
  hookToken      String?  @unique @map("hook_token")
  summary        String
  requestedBy    String?  @map("requested_by")
  status         String
  createdAt      DateTime @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")

  @@index([status])
  @@map("confirmation")
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  target     String
  beforeJson String?  @map("before_json") @db.Text
  afterJson  String?  @map("after_json") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([action])
  @@map("audit_log")
}

model KnowledgeDoc {
  id        String   @id @default(cuid())
  path      String   @unique
  title     String
  content   String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("knowledge_doc")
}

/// Append-only conversation history per scope (channel / DM / thread).
/// Both user-authored and assistant-authored turns are stored. Loaded by
/// runAgentZ as chat messages (`messages` array), not as a pasted log inside system prompts.
model ConversationTurn {
  id          String   @id @default(cuid())
  channelId   String   @map("channel_id")
  userId      String   @map("user_id")
  role        String
  content     String   @db.Text
  toolCalls   Json?    @map("tool_calls")
  modelId     String?  @map("model_id")
  agentRunId  String?  @map("agent_run_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([channelId, createdAt])
  @@index([userId, createdAt])
  @@map("conversation_turn")
}

/// Persistent per-user profile maintained by the agent via the
/// `remember_about_user` tool. Cleared by `/forget-me` and the
/// `forget_about_user` admin tool.
model UserProfile {
  userId          String   @id @map("user_id")
  displayName     String?  @map("display_name")
  notesJson       Json     @default("[]") @map("notes_json")
  preferencesJson Json     @default("{}") @map("preferences_json")
  lastSeenAt      DateTime? @map("last_seen_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("user_profile")
}

/// Replaces the workflow-based reminder path. Rows are inserted by the
/// `schedule_message` MCP tool and drained by /api/cron/scheduled-msgs.
model ScheduledMessage {
  id            String   @id @default(cuid())
  channelId     String   @map("channel_id")
  guildId       String?  @map("guild_id")
  scheduledFor  DateTime @map("scheduled_for")
  content       String   @db.Text
  components    Json?
  authorUserId  String   @map("author_user_id")
  targetUserIds String[] @default([]) @map("target_user_ids")
  status        String   @default("pending")
  sentAt        DateTime? @map("sent_at")
  attempts      Int      @default(0)
  lastError     String?  @map("last_error") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([status, scheduledFor])
  @@index([channelId])
  @@map("scheduled_message")
}

/// Append-only archive of every Discord message the gateway forwards. Powers
/// the Oversight Layer: tier-gated semantic search, channel summaries,
/// referenced-message lookup, and audit trails. Embeddings are populated
/// asynchronously by /api/cron/embed-batch from the Redis Streams queue.
/// The embedding column is pgvector(1536); Prisma reads/writes it via raw SQL.
model Message {
  id                  String    @id
  channelId           String    @map("channel_id")
  guildId             String?   @map("guild_id")
  authorId            String    @map("author_id")
  authorName          String?   @map("author_name")
  authorIsBot         Boolean   @default(false) @map("author_is_bot")
  content             String    @default("") @db.Text
  referencedMessageId String?   @map("referenced_message_id")
  attachments         Json      @default("[]")
  mentionUserIds      String[]  @default([]) @map("mention_user_ids")
  embeddingModel      String?   @map("embedding_model")
  embeddedAt          DateTime? @map("embedded_at")
  sentAt              DateTime  @map("sent_at")
  editedAt            DateTime? @map("edited_at")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([channelId, sentAt])
  @@index([guildId, sentAt])
  @@index([authorId, sentAt])
  @@index([embeddedAt])
  @@map("message")
}

/// Discord-staged moderation / admin mutation; confirmed via MessageComponent buttons.
model PendingAction {
  id                         String    @id @default(cuid())
  token                      String    @unique
  invokerUserId              String    @map("invoker_user_id")
  guildId                    String?   @map("guild_id")
  channelId                  String?   @map("channel_id")
  capability                 String
  inputJson                  String    @db.Text @map("input_json")
  summary                    String    @db.Text
  status                     String    @default("pending")
  resultText                 String?   @db.Text @map("result_text")
  createdAt                  DateTime  @default(now()) @map("created_at")
  resolvedAt                 DateTime? @map("resolved_at")
  expiresAt                  DateTime  @map("expires_at")
  interactionToken           String?   @map("interaction_token")
  interactionApplicationId   String?   @map("interaction_application_id")

  @@index([status, expiresAt])
  @@index([invokerUserId])
  @@map("pending_action")
}

/// Tracks reaction-role / verification grants so we can audit and revoke.
model VerificationGrant {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  guildId            String    @map("guild_id")
  roleId             String    @map("role_id")
  reactionMessageId  String?   @map("reaction_message_id")
  reactionEmoji      String?   @map("reaction_emoji")
  grantedAt          DateTime  @default(now()) @map("granted_at")
  revokedAt          DateTime? @map("revoked_at")
  revokedReason      String?   @map("revoked_reason")

  @@unique([userId, guildId, roleId])
  @@index([guildId])
  @@map("verification_grant")
}
