# --- Shared with parent repo (see ../.env) ---
DISCORD_BOT_TOKEN=

# Auto-picks guild if a single id in DISCORD_ALLOWED_GUILD_IDS, else set:
# REACTION_GUILD_ID=
# (or DISCORD_GUILD_ID)

# Reaction-role (required for verify flow)
REACTION_MESSAGE_ID=
REACTION_VERIFIED_ROLE_ID=
# REACTION_EMOJI=✅
# REACTION_WELCOME_DM_ENABLED=1

# App id (optional) — for `npm run register`; the bot can resolve it from the token via API, or
# use the same id as the bot user. Used at runtime when set; otherwise the bot user id is used.
# DISCORD_APPLICATION_ID=
# or: DISCORD_CLIENT_ID=
#
# The bot re-registers /agent-z on every startup. Set to disable:
# AGENT_Z_SKIP_SLASH_UPSERT=1
#
# If slash commands do not show: re-invite with **applications.commands** in the URL scope, e.g.:
# https://discord.com/api/oauth2/authorize?client_id=YOUR_APP_ID&permissions=0&scope=bot%20applications.commands

# --- Agent Z (AI) ---
AI_GATEWAY_API_KEY=

# Privileged channel(s) where Admin/Mod roles unlock Discord REST; comma-separated
AGENT_Z_PRIVILEGED_CHANNEL_IDS=
AGENT_Z_ADMIN_ROLE_IDS=
AGENT_Z_MODERATOR_ROLE_IDS=
# Optional: users without this role get completely ignored (recommend: Verified role id)
# AGENT_Z_INVOKE_ROLE_ID=

# Protected user (hard block in tooling) — your snowflake, never shown in replies
AGENT_Z_OWNER_USER_ID=

# 1 = @-mention works in all public channels (knowledge-only). 0 = bot silent outside privileged channels
# AGENT_Z_PUBLIC_TIER_ENABLED=1
#
# Optional: 1 = request Message Content + GuildMessages so @-mention works. Also enable
# "Message Content Intent" in the Developer Portal, or the gateway will error on connect.
# AGENT_Z_MESSAGE_CONTENT_INTENT=1

# Optional: custom system prompt .md
# AGENT_Z_PROMPT_OVERRIDE_PATH=
# Model id via AI Gateway
# AGENT_Z_MODEL_ID=anthropic/claude-haiku-4.5

# Optional: path to a folder of .md files to copy into knowledge/ at build (Vercel plugin skills, etc.)
# AGENT_Z_KNOWLEDGE_SOURCE=
# Or override output dir
# AGENT_Z_KNOWLEDGE_DIR=./knowledge

# Rate limits
# AGENT_Z_USER_RPM=5
# AGENT_Z_USER_DAILY=50
# AGENT_Z_GLOBAL_RPM=30
# AGENT_Z_GLOBAL_DAILY=500
# AGENT_Z_RATELIMIT_BYPASS_USER_IDS=

# Let MCP/bot remove Verified role via API (off by default)
# MCP_ALLOW_DELETE_VERIFIED_ROLE=0
